  m_Script: {fileID: 11500000, guid: 56729fc72a240814fa421adee2309381, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingDirector
  gameFlowController: {fileID: 1926243287}
  missionUI: {fileID: 2125966795}
  toyFriend: {fileID: 0}
  toyFriendStoryTransitionDuration: 0.35
  endingTitle: DREAM RESTORED
  endingSubtitle: "\uAFC8\uB098\uB77C\uC5D0 \uB2E4\uC2DC \uBE5B\uC774 \uB3CC\uC544\uC654\uC2B5\uB2C8\uB2E4"
  speaker: "\uC7A5\uB09C\uAC10 \uCE5C\uAD6C"
  firstMessage: "\uBAA8\uB450\uC758 \uC6A9\uAE30 \uB355\uBD84\uC5D0 \uC545\uBABD\uC774
    \uC0AC\uB77C\uC84C\uC5B4. \uC815\uB9D0 \uACE0\uB9C8\uC6CC!"
  secondMessage: "\uD604\uC2E4\uB85C \uB3CC\uC544\uAC00\uB354\uB77C\uB3C4 \uC624\uB298\uC758
    \uAFC8\uACFC \uD798\uC744 \uC78A\uC9C0 \uB9D0\uC544 \uC918."
  thirdMessage: "\uD604\uC2E4\uB85C \uB3CC\uC544\uAC00\uB354\uB77C\uB3C4, \uAC01\uC790\uC758
    \uAFC8\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574 \uACC4\uC18D \uB178\uB825\uD574
    \uC918."
  fourthMessage: "\uAFC8\uC744 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4\uBA74,
    \uC5B8\uC820\uAC00 \uADF8 \uAFC8\uC5D0 \uAF2D \uB2FF\uC744 \uC218 \uC788\uC744
    \uAC70\uC57C!"
  finalTitle: THE END
  finalSubtitle: Dream Guardians
  openingBannerDuration: 3
  firstDialogueDuration: 3
  secondDialogueDuration: 3
  thirdDialogueDuration: 3.8
  fourthDialogueDuration: 3.8
  finalBannerDuration: 4
  currentState: 0
