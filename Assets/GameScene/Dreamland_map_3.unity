--- !u!114 &1926243289
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1926243285}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5d49bbb5483c6a4797a637732363cfb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stage2Director
  waveController: {fileID: 1926243288}
  missionUI: {fileID: 2125966795}
  toyFriend: {fileID: 0}
  toyFriendStoryTransitionDuration: 0.35
  stageStartTitle: STAGE 2 START
  stageStartSubtitle: "\uD655\uC7A5\uB418\uB294 \uAFC8\uC758 \uADE0\uC5F4\uC744 \uB9C9\uC544\uB77C"
  stageObjective: "Stage 2 \xB7 \uCF54\uC5B4\uB97C \uC9C0\uD0A4\uBA70 \uBAA8\uB4E0
    \uC545\uBABD\uC744 \uC815\uD654\uD558\uB77C"
  stageStartBannerDuration: 2
  firstWaveTitle: STAGE 2 - WAVE 1
  secondWaveTitle: STAGE 2 - WAVE 2
  finalWaveTitle: STAGE 2 - WAVE 3
  finalPhaseTitle: FINAL PHASE
  finalPhaseSubtitle: "\uB0A8\uC740 \uC545\uBABD\uC744 \uBAA8\uB450 \uC815\uD654\uD558\uB77C"
  waveBannerDuration: 1.5
  progressRefreshInterval: 0.2
  quickGuideDuration: 3
  stageStartGuideMessage: "\uC545\uBABD \uBC14\uC774\uB7EC\uC2A4\uAC00 \uB354 \uAC15\uD574\uC84C\uC5B4.
    \uCF54\uC5B4\uB97C \uACC4\uC18D \uC9C0\uCF1C\uC918!"
  firstWaveGuideMessage: "\uAC80\uC740 \uADE0\uC5F4\uC774 \uB2E4\uC2DC \uC5F4\uB9AC\uACE0
    \uC788\uC5B4. \uCF54\uC5B4\uC5D0 \uB2FF\uAE30 \uC804\uC5D0 \uBAA8\uB450 \uC815\uD654\uD574!"
  secondWaveGuideMessage: "\uADE0\uC5F4\uC774 \uB354 \uCEE4\uC9C0\uACE0 \uC788\uC5B4.
    \uC0AC\uBC29\uC5D0\uC11C \uC624\uB294 \uC7A5\uB09C\uAC10\uB4E4\uC744 \uC870\uC2EC\uD574!"
  finalWaveGuideMessage: "\uAFC8\uB098\uB77C\uAC00 \uD604\uC2E4\uC744 \uB36E\uACE0
    \uC788\uC5B4. \uB9C8\uC9C0\uB9C9 \uACF5\uACA9\uC774\uC57C. \uC870\uAE08\uB9CC
    \uB354 \uBC84\uD168!"
  clearTitle: STAGE 2 CLEAR
  clearSubtitle: "\uAFC8\uC758 \uADE0\uC5F4\uC774 \uC57D\uD574\uC84C\uC2B5\uB2C8\uB2E4"
  clearSpeaker: "\uC7A5\uB09C\uAC10 \uCE5C\uAD6C"
  clearMessage: "\uD574\uB0C8\uC5B4! \uB0A8\uC740 \uAFC8\uBE5B\uC774 \uD558\uB098\uB85C
    \uBAA8\uC774\uBA70 \uC0C8\uB85C\uC6B4 \uAE38\uC744 \uC5F4\uACE0 \uC788\uC5B4!"
  clearBannerDuration: 3
  clearDialogueDuration: 3
  failedTitle: MISSION FAILED
  failedSubtitle: "\uAFC8\uBE5B \uCF54\uC5B4\uAC00 \uBB34\uB108\uC84C\uC2B5\uB2C8\uB2E4"
  failedBannerDuration: 3
  currentState: 0
--- !u!114 &1926243290
MonoBehaviour:
  m_ObjectHideFlags: 0
